# Copy this file to keystore.properties (git-ignored) and fill in your values.
# - storeFile: absolute path to a keystore stored OUTSIDE this repository.
# - No spaces around "=".
# - With the default PKCS12 keystore, keyPassword must be the same as storePassword.
storeFile=/home/you/.keystores/hashira-release.jks
storePassword=change-me
keyAlias=hashira
keyPassword=change-me
